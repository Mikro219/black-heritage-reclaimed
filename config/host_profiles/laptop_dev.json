{
  "profile_name": "laptop_dev",
  "camera": {
    "backend": "dshow",
    "device_name_match": null,
    "resolution": [
      1280,
      720
    ],
    "fps": 30,
    "fallback_index": 0
  },
  "microphone": {
    "device_name_match": null,
    "sample_rate": 16000,
    "channels": 1,
    "fallback_index": 0
  },
  "display": {
    "fullscreen": false,
    "resolution": [
      1280,
      720
    ],
    "projector_audio_offset_ms": 0
  },
  "performance": {
    "mediapipe_complexity": 0,
    "render_fps_cap": 30,
    "debug_overlay": true
  },
  "voice_tuning": {
    "hum_rms_threshold": 0.008,
    "hum_min_duration_ms": 400,
    "whisper_max_volume_dbfs": -20.0
  },
  "gesture_tuning": {
    "reach_flask": {
      "area_growth_threshold": 0.3,
      "window_frames": 12,
      "target_region": "upper_center"
    },
    "point_quilt_block": {
      "target_region": "top_left_quadrant",
      "hold_ms": 800
    },
    "point_path \u2014 LEFT": {
      "directions": [
        "left"
      ],
      "hold_ms": 500,
      "dead_zone_frac": 0.99
    },
    "point_path \u2014 RIGHT": {
      "directions": [
        "right"
      ],
      "hold_ms": 500,
      "dead_zone_frac": 1.05
    },
    "point_river_marker": {
      "target_region": "lower_third",
      "hold_ms": 500
    },
    "point_dipper_corner": {
      "target_region": "top_right_quadrant",
      "hold_ms": 500
    },
    "raise_hands": {
      "y_threshold": "shoulder",
      "hold_ms": 500
    },
    "look_up (bilateral raise)": {
      "y_threshold": "head",
      "hold_ms": 300
    },
    "cup_ear_listen": {
      "direction": "ear",
      "hold_ms": 500,
      "ear_radius": 0.22
    },
    "survey": {
      "brow_y": 0.45,
      "hold_ms": 200,
      "scan_window_ms": 2000,
      "min_x_delta": 0.01
    },
    "trace_dipper \u2014 stroke 1: LEFT": {
      "direction": "left",
      "window_ms": 400,
      "min_displacement": 0.04
    },
    "trace_dipper \u2014 stroke 2: DOWN": {
      "direction": "down",
      "window_ms": 400,
      "min_displacement": 0.04
    },
    "trace_dipper \u2014 stroke 3: RIGHT": {
      "direction": "right",
      "window_ms": 400,
      "min_displacement": 0.04
    },
    "trace_dipper \u2014 stroke 4: UP": {
      "direction": "up",
      "window_ms": 400,
      "min_displacement": 0.04
    },
    "trace_dipper \u2014 strokes 5-7: UP-LEFT": {
      "direction": "up_left",
      "window_ms": 400,
      "min_displacement": 0.04
    },
    "trace_star \u2014 stroke 1: UP-RIGHT": {
      "direction": "up_right",
      "window_ms": 400,
      "min_displacement": 0.04
    },
    "drink_gesture": {
      "hold_ms": 400,
      "proximity_threshold": 0.12
    },
    "three_knock": {
      "short_window_ms": 500,
      "long_min_ms": 400,
      "long_max_ms": 1400,
      "threshold_fraction": 0.3,
      "refractory_ms": 220,
      "wrist_y_offset": -0.05
    },
    "fast_gather": {
      "speed_multiplier": 2.0,
      "use_pose": true
    },
    "touch_temple": {
      "hands_required": 1,
      "hold_ms": 500,
      "target": "temple",
      "use_pose": true,
      "radius_scale": 1.0
    },
    "hands_to_head": {
      "hands_required": 2,
      "hold_ms": 500,
      "radius_scale": 4.0
    },
    "arms_crossed": {
      "hold_ms": 500,
      "dead_zone_frac": 0.05
    },
    "forward_push": {
      "min_growth_pct": 50,
      "window_ms": 250
    },
    "launch_push": {
      "min_growth_pct": 100,
      "window_ms": 400
    },
    "run_arms": {
      "min_cycles": 3,
      "window_ms": 2000,
      "waist_y_offset": -0.09
    },
    "unravel": {
      "min_cycles": 2,
      "window_ms": 3000,
      "min_amplitude_frac": 0.9,
      "prox_frac": 1.75
    },
    "paddle": {
      "min_strokes": 3,
      "sync_window_ms": 400,
      "waist_y_offset": -0.18
    },
    "throw": {
      "max_stroke_ms": 600,
      "shoulder_margin": 0.03,
      "release_y_offset": 0.0,
      "require_growth": false,
      "min_growth_pct": 40,
      "min_pose_z_delta": 0.2
    }
  }
}